{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bank_export_item.schema.json",
  "title": "DeutschMaster Bank Export Item",
  "schema_version": 1,
  "description": "Shape of a single item inside a bank export bundle (web/data/items_*.json and web/data/all_items.json). This is the linchpin fixture named by 02-content-pipeline.md stage 5: the SAME document is asserted from the Python bank test suite (tests/test_bank.py::test_export_schema_matches_client_expectation) and must also be asserted from the web test suite (tests/test_web.py, owned by the web/ agent) so a server-side export change that breaks the client fails here first instead of silently drifting. Bumping 'schema_version' is a breaking-change signal to both sides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "cefr",
    "difficulty",
    "prompt",
    "accepted_answers",
    "distractors"
  ],
  "properties": {
    "id": { "type": "string" },
    "topic_id": { "type": "string" },
    "tag_id": { "type": ["string", "null"] },
    "dimension": { "type": "string", "enum": ["grammar", "vocab"] },
    "type": {
      "type": "string",
      "enum": [
        "cloze_free",
        "cloze_cued",
        "error_correction",
        "transformation",
        "paragraph_cloze",
        "production"
      ]
    },
    "cefr": { "type": "string", "enum": ["A1", "A2", "B1", "B2"] },
    "difficulty": { "type": "integer", "enum": [1, 2, 3] },
    "prompt": { "type": "string" },
    "cue": { "type": ["string", "null"] },
    "rule_hint": { "type": ["string", "null"] },
    "accepted_answers": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "distractors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "implied_topic_id": { "type": ["string", "null"] },
          "misconception": { "type": ["string", "null"] }
        }
      }
    },
    "block_id": { "type": ["string", "null"] },
    "block_position": { "type": ["integer", "null"] },
    "confusion_group": { "type": ["string", "null"] },
    "facet": { "type": ["string", "null"] },
    "carrier_lemmas": {
      "type": "array",
      "items": { "type": "string" }
    },
    "domain": { "type": ["string", "null"] },
    "source_sentence_id": { "type": ["string", "null"] },
    "gloss_en": { "type": ["string", "null"] }
  }
}
