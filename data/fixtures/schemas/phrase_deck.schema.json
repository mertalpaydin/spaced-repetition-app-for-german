          "count_by_source": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Count By Source",
            "type": "object"
          },
          "display_de": {
            "minLength": 1,
            "title": "Display De",
            "type": "string"
          },
          "gloss_en": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Gloss En"
          },
          "glossed_card_count": {
            "default": 0,
            "minimum": 0,
            "title": "Glossed Card Count",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "verb_prep",
              "reflexive_verb",
              "separable_verb",
              "noun_verb",
              "adj_noun",
              "connector",
              "two_part_connector",
              "idiom"
            ],
            "title": "Kind",
            "type": "string"
          },
          "lemma_key": {
            "minLength": 1,
