          },
          "rank": {
            "minimum": 1,
            "title": "Rank",
            "type": "integer"
          },
          "sentence_count": {
            "minimum": 0,
            "title": "Sentence Count",
            "type": "integer"
          },
          "source": {
            "enum": [
              "mined",
              "curated",
              "mined+curated"
            ],
            "title": "Source",
            "type": "string"
          },
          "trivial": {
            "default": false,
            "title": "Trivial",
            "type": "boolean"
          },
          "trivial_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trivial Reason"
          },
          "unit_id": {
            "minLength": 4,
            "title": "Unit Id",
            "type": "string"
          }
        },
        "required": [
          "unit_id",
          "kind",
          "lemma_key",
          "parts",
          "display_de",
          "sentence_count",
          "rank",
          "source",
          "card_count"
        ],
        "title": "PhraseUnit",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Every unit, no cards: what the triage screen loads.",
    "properties": {
      "schema_version": {
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "units": {
        "items": {
          "$ref": "#/$defs/PhraseUnit"
        },
        "title": "Units",
        "type": "array"
      }
    },
    "required": [
      "units"
    ],
    "title": "UnitsIndex",
    "type": "object"
  }
}
