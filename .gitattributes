# Normalise line endings.
#
# The repo previously stored CRLF with no .gitattributes and core.autocrlf
# unset, so every file that round-tripped through a Linux tool came back as LF
# and showed up as a whole-file diff. LF in the repo AND in the working tree
# removes that class of noise entirely: CI runs on ubuntu, and Windows editors
# and Python both handle LF without complaint.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
*.gz binary
*.tgz binary
*.whl binary
*.pyc binary
