# Gemini API Configuration
# Two-lane setup: two separate Google Cloud projects are required, not optional.
# Quota is enforced per project, not per key, and enabling billing on a project
# removes its free tier entirely. See docs/01-foundation.md.
GEMINI_FREE_API_KEY=
GEMINI_PAID_API_KEY=
# Legacy single-key fallback, used only when the two lane-specific keys above
# are unset. Prefer the two keys above for any real deployment.
GEMINI_API_KEY=

# Model Selection
MODEL_LIVE=gemini-3.5-flash-lite
MODEL_GENERATE=gemini-3.5-flash-lite
MODEL_VERIFY=gemini-3.7-flash

# Environment
ENVIRONMENT=development

# Azure Translator (TODO 5.1 step 2, the learner-facing English gloss).
# Free F0 tier: 2,000,000 characters a month, permanent, no card. Create at
# https://portal.azure.com/#create/Microsoft.CognitiveServicesTextTranslation
# Leave AZURE_TRANSLATOR_REGION empty for a resource created with Region
# "Global"; a region-locked resource needs both its own endpoint and region.
# With no key configured the backfill degrades to the Gemini fallback and
# says so, rather than failing.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=
